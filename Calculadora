package com.example.calculadora;

import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {
    TextView textResultado;
    TextView caja2; //Esta es la caja que está encima, donde se hacen las operaciones
    int valorAnterior=0 ;//float valorAnterior=0 ;
    boolean pulsadoSumar=false;
    boolean sumaActiva=false;
    boolean pulsadoRestar=false;
    boolean restaActiva=false;

    @Override
    protected void onCreate(Bundle savedInstanceState) { //
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);

        setContentView(R.layout.activity_main);
        textResultado = findViewById(R.id.texto);
        textResultado.setText("0");
        textResultado.setTextSize(100);
        caja2= findViewById(R.id.texto2); //Texto2 es la segunda caja, declarada en xml
        //R. se refiere a algo de paquetes
        sumaActiva=false;
        restaActiva=false;
    }

    public void sumar(View boton){
        caja2.setText(textResultado.getText() + " + ");
        valorAnterior=Integer.parseInt(textResultado.getText().toString());
        pulsadoSumar=true; //si está en false, tras pulsar botón "+" no te borra el num anterior
    }

    public void restar(View boton){
        caja2.setText(textResultado.getText() + " - ");
        valorAnterior=Integer.parseInt(textResultado.getText().toString());
        pulsadoRestar=true;
    }
    public void reset (View boton) {
        //Button btn_reset = (Button) boton;
        textResultado.setText("0");
        caja2.setText("");
        valorAnterior=0;
        pulsadoSumar=true;
        pulsadoRestar=true;
    }

    public void resultado(View boton){
    caja2.setText(caja2.getText().toString() + textResultado.getText().toString() + " = ");
    //se pasa el contenido de setText a String porque la funcion setText() no acepta valores enteros
        if(sumaActiva){
            textResultado.setText(Integer.toString(valorAnterior + Integer.parseInt(textResultado.getText().toString())));
        }
        if(restaActiva){
                textResultado.setText(Integer.toString(valorAnterior - Integer.parseInt(textResultado.getText().toString())));
        }

    }
    public void numero (View boton) { //Actúa cuando pulsas un numero
        Button btn_numero = (Button) boton;
        if(pulsadoSumar==true){
            textResultado.setText("");
            pulsadoSumar=false;
            sumaActiva=true;
        }
        if(pulsadoRestar==true){  //aquí cuando ya se ha pulsado el botón "-", y se pulsan los numeros a restar te resetea la caja principal
            textResultado.setText("");
            pulsadoRestar=false;
            restaActiva=true;
        }

        //Esta línea hace que cuando pulsas un número quite primero el 0 antes de añadir el numero pulsado
        if (textResultado.getText().equals("0")) {
            textResultado.setText("");
        }

        //esta línea hace que se concatenen los numeros (ej: si pulso 68 que me los junte)
        //textResultado.setText(textResultado.getText() + btn_numero.getText().toString());

        //if length es mayor que x, que no lo añada
        if(textResultado.getText().length()<6){
            textResultado.setText(textResultado.getText() + btn_numero.getText().toString());
        }
    }
}










































